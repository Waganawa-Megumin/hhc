# HHC environment — copy to `.env` and fill in. NEVER commit `.env` (see .gitignore).
# Layer-1 (the checklist + scoring web UI) needs NONE of these. They are only used
# by the agent backend (§6 AI interpret / §7 OSINT) which is added in later phases.

# --- Required for §6/§7 (the keyed agent backend) ---
# Your own Anthropic API key. Used only when you explicitly trigger interpret/OSINT.
# A secret/var named HHC_KEY is also accepted as an alias for this value.
ANTHROPIC_API_KEY=

# Passphrase/key for the encrypted local case DB (SQLCipher). Choose a strong value.
# If unset, the case-history features (§7.3) stay disabled.
HHC_DB_KEY=

# --- Optional OSINT source credentials (everything degrades gracefully if unset) ---
# Japan NTA corporate-number Web-API application ID (free; ~1–1.5 month lead time).
HHC_HOUJIN_APP_ID=
# gBizINFO REST API token (free).
HHC_GBIZ_INFO_API_KEY=
# OpenCorporates API token (free tier limited).
HHC_OPENCORPORATES_TOKEN=
# OpenSanctions hosted API key (free for personal/non-commercial). Leave blank to
# use a self-hosted yente instance via HHC_OPENSANCTIONS_BASE_URL instead.
HHC_OPENSANCTIONS_API_KEY=
HHC_OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
# US Trade.gov ITA subscription key (free; covers the Consolidated Screening List).
HHC_TRADEGOV_API_KEY=

# --- Behaviour switches ---
# Set to 1 to force every network OSINT tool to report "source unavailable" (for
# offline demos / restricted networks). Layer-1 is unaffected.
HHC_OFFLINE=0
# Model used for §6/§7 (latest Sonnet by default; can escalate to claude-opus-4-8).
HHC_MODEL=claude-sonnet-4-6
# Port the agent backend binds on (127.0.0.1 in dev; 0.0.0.0 in served mode).
HHC_AGENT_PORT=8787

# --- Authentication & accounts (opt-in) ---
# Set to 1 to require login for the WHOLE app (email-ID accounts, Admin/User roles,
# MFA, authz). When on, HHC_DB_KEY and HHC_SESSION_SECRET are REQUIRED (the agent
# refuses to start otherwise) and the first admin is bootstrapped from HHC_ADMIN_*.
HHC_AUTH=0
# Have the agent serve the built web SPA + API itself on HHC_AGENT_PORT (0.0.0.0)
# with trustProxy, so the real client IP is visible (needed for the audit log).
# `npm run serve` sets this + HHC_AUTH=1 and is the hosted/edge deployment.
HHC_SERVE_WEB=0
# Secret for session cookies + sealing the TOTP secret at rest. REQUIRED if HHC_AUTH=1.
# Use a long random value (e.g. `openssl rand -base64 48`).
HHC_SESSION_SECRET=
# Session lifetimes.
HHC_SESSION_TTL_HOURS=12
HHC_SESSION_IDLE_MIN=60
# Login lockout: max failed attempts per window (counted by email OR IP).
HHC_LOGIN_MAX_FAILS=5
HHC_LOGIN_WINDOW_MIN=15
# First-admin bootstrap (used once, when no users exist). Required if HHC_AUTH=1.
# The admin must change this password and enroll MFA at first login.
HHC_ADMIN_EMAIL=
HHC_ADMIN_INITIAL_PASSWORD=

# --- Email MFA transport (optional; unset → email MFA is a graceful no-op, use TOTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Audit geolocation (keyless; degrades gracefully if blocked/offline) ---
HHC_GEO_ENABLED=1
HHC_GEO_BASE_URL=http://ip-api.com/json
