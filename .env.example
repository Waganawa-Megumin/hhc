# HHC environment — copy to `.env` and fill in. NEVER commit `.env` (see .gitignore).
# Layer-1 (the checklist + scoring web UI) needs NONE of these. They are only used
# by the agent backend (§6 AI interpret / §7 OSINT) which is added in later phases.

# --- Required for §6/§7 (the keyed agent backend) ---
# Your own Anthropic API key. Used only when you explicitly trigger interpret/OSINT.
# A secret/var named HHC_KEY is also accepted as an alias for this value.
ANTHROPIC_API_KEY=

# Passphrase/key for the encrypted local case DB (SQLCipher). Choose a strong value.
# If unset, the case-history features (§7.3) stay disabled.
HHC_DB_KEY=

# --- Optional OSINT source credentials (everything degrades gracefully if unset) ---
# Japan NTA corporate-number Web-API application ID (free; ~1–1.5 month lead time).
HHC_HOUJIN_APP_ID=
# gBizINFO REST API token (free).
HHC_GBIZ_INFO_API_KEY=
# OpenCorporates API token (free tier limited).
HHC_OPENCORPORATES_TOKEN=
# OpenSanctions hosted API key (free for personal/non-commercial). Leave blank to
# use a self-hosted yente instance via HHC_OPENSANCTIONS_BASE_URL instead.
HHC_OPENSANCTIONS_API_KEY=
HHC_OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
# US Trade.gov ITA subscription key (free; covers the Consolidated Screening List).
HHC_TRADEGOV_API_KEY=

# --- Behaviour switches ---
# Set to 1 to force every network OSINT tool to report "source unavailable" (for
# offline demos / restricted networks). Layer-1 is unaffected.
HHC_OFFLINE=0
# Model used for §6/§7 (latest Sonnet by default; can escalate to claude-opus-4-8).
HHC_MODEL=claude-sonnet-4-6
# Port the local agent backend binds on (127.0.0.1 only).
HHC_AGENT_PORT=8787
